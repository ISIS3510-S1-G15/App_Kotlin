<?xml version="1.0" encoding="utf-8"?>
<!-- Ver backup_rules.xml: sesion cifrada, base local y DataStore no se respaldan ni se transfieren. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="campus_eats_session_secure.xml" />
        <exclude domain="sharedpref" path="campus_eats_analytics.xml" />
        <exclude domain="database" path="campus_eats_local.db" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="campus_eats_session_secure.xml" />
        <exclude domain="sharedpref" path="campus_eats_analytics.xml" />
        <exclude domain="database" path="campus_eats_local.db" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
