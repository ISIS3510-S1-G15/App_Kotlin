<?xml version="1.0" encoding="utf-8"?>
<!--
   La sesion cifrada depende de una clave del Keystore que NO se respalda, y la base local / DataStore contienen
   datos del usuario y una cola de sincronizacion: nada de esto debe restaurarse en otro dispositivo.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="campus_eats_session_secure.xml" />
    <exclude domain="sharedpref" path="campus_eats_analytics.xml" />
    <exclude domain="database" path="campus_eats_local.db" />
    <exclude domain="file" path="datastore/" />
</full-backup-content>
